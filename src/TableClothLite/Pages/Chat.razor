@page "/"
@page "/Chat"

@using TableClothLite.Components.Catalog
@using TableClothLite.Components.Settings
@using TableClothLite.Services
@using TableClothLite.Components.Guide
@using TableClothLite.Components.Chat
@using TableClothLite.Shared

@inject IJSRuntime JSRuntime

<PageTitle>무설치 식탁보</PageTitle>

<div class="chat-app">
    <div class="chat-main">
        @* 부드러운 업데이트 알림 *@
        @if (_showUpdateNotification && _pendingUpdate is not null)
        {
            <div class="update-notification">
                <div class="update-notification-content">
                    <div class="update-info">
                        <span class="update-icon">🎉</span>
                        <div class="update-text">
                            <strong>새 버전이 있습니다!</strong>
                            <div class="version-details">@_pendingUpdate.Version</div>
                        </div>
                    </div>
                    <div class="update-actions">
                        <button @onclick="ApplyUpdateAsync" class="update-btn primary" type="button">업데이트</button>
                        <button @onclick="DismissUpdateNotification" class="update-btn secondary" type="button">나중에</button>
                    </div>
                </div>
            </div>
        }

        <!-- 상단 헤더 -->
        <div class="chat-header">
            <div class="header-left">
                <div class="app-title-header">
                    <img src="favicon.png" alt="식탁보" class="header-app-icon">
                    <span class="app-name">무설치 식탁보</span>
                </div>
            </div>
            <div class="header-actions">
                <div class="menu-dropdown">
                    <button @onclick="ToggleMenuDropdown" class="header-action-btn" title="메뉴" type="button">⋯</button>
                    <div class="menu-dropdown-content @(_showMenuDropdown ? "show" : "")">
                        <button @onclick="OpenServicesModalAndHideMenu" class="dropdown-item" type="button">
                            🛒 지원 사이트 목록
                        </button>
                        <button @onclick="OpenSandboxGuideAndHideMenu" class="dropdown-item" type="button">
                            🪟 Windows Sandbox 안내
                        </button>
                        <button @onclick="OpenSettingDialogAndHideMenu" class="dropdown-item" type="button">
                            ⚙️ 설정
                        </button>
                        <div class="dropdown-divider"></div>
                        <a href="https://github.com/sponsors/yourtablecloth" target="_blank" class="dropdown-item" @onclick="HideMenuDropdown">
                            💝 개발 후원하기
                        </a>
                        <a href="https://github.com/yourtablecloth/TableClothLite" target="_blank" class="dropdown-item" @onclick="HideMenuDropdown">
                            <strong>{;}</strong> GitHub
                        </a>
                        <a href="https://yourtablecloth.app/" target="_blank" class="dropdown-item" @onclick="HideMenuDropdown">
                            🏠 식탁보 홈페이지
                        </a>
                    </div>
                </div>

                <ThemeToggle Compact="true" />
            </div>
        </div>

        <!-- 랜딩 영역 -->
        <div class="landing-container">
            <div class="landing-content">
                <div class="logo-container">
                    <img src="icon-512.png" alt="식탁보" class="welcome-logo" />
                </div>
                <h1>설치 없이, 안전하게.</h1>
                <p class="welcome-subtitle">
                    Windows Sandbox만 있으면 은행·공공 웹 사이트를 격리된 일회용 환경에서 바로 이용할 수 있습니다.
                </p>

                @* AI 기능 복귀 공지 *@
                <div class="ai-notice">
                    <span class="ai-notice-icon">🤖</span>
                    <div class="ai-notice-text">
                        <strong>AI 기능은 잠시 자리를 비웁니다.</strong>
                        기존 AI 채팅 기능은 종료되었으며, <b>더 나은 형태로 다시 찾아올 예정</b>입니다.
                        그동안 무설치 식탁보 본연의 기능에 집중합니다.
                    </div>
                </div>

                @* 주요 동작 *@
                <div class="action-cards">
                    <button class="action-card primary" @onclick="DownloadGeneralLauncher" type="button">
                        <span class="action-icon">📥</span>
                        <span class="action-title">무설치 실행 파일 받기</span>
                        <span class="action-desc">최신 식탁보를 자동으로 받아 실행하는 .wsb 파일</span>
                    </button>
                    <button class="action-card" @onclick="OpenServicesModal" type="button">
                        <span class="action-icon">🛒</span>
                        <span class="action-title">지원 사이트에서 선택</span>
                        <span class="action-desc">원하는 은행·공공 사이트를 골라 바로 여는 .wsb 생성</span>
                    </button>
                </div>

                @* 사용 방법 *@
                <div class="how-steps">
                    <div class="how-step"><span class="how-num">1</span><span>.wsb 파일을 내려받습니다</span></div>
                    <div class="how-step"><span class="how-num">2</span><span>파일을 더블클릭하면 Windows Sandbox가 열립니다</span></div>
                    <div class="how-step"><span class="how-num">3</span><span>샌드박스 안에서 식탁보가 자동으로 실행됩니다</span></div>
                </div>

                @if (!_isWindowsOS)
                {
                    <div class="os-warning">
                        ⚠️ 이 기능은 <b>Windows 10/11</b>의 Windows Sandbox에서 동작합니다.
                        현재 기기에서는 .wsb 실행이 지원되지 않을 수 있습니다.
                    </div>
                }

                <div class="disclaimer-note">
                    🔒 생성되는 .wsb는 <b>호스트 폴더를 마운트하지 않아</b> 내 PC의 파일에 접근하지 않으며,
                    공식 GitHub 릴리스의 서명된 런처만 사용합니다.
                </div>

                @if (!_sponsorBannerDismissed)
                {
                    <div style="margin-top: 24px;">
                        <SponsorBanner OnDismiss="DismissSponsorBanner" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Windows Sandbox 가이드 모달 *@
@if (_showSandboxGuide)
{
    <SandboxGuideModal IsWindowsOS="@_isWindowsOS"
                       OnClose="CloseSandboxGuide" />
}

@* WSB 다운로드 가이드 모달 *@
@if (_showWsbDownloadGuide && _currentService != null)
{
    <WsbDownloadGuideModal ServiceUrl="@_currentService.Url"
                           ServiceDisplayName="@_currentService.DisplayName"
                           OnClose="CloseWsbDownloadGuide"
                           OnDownloadWsb="DownloadWsbAnyway" />
}

@* 서비스 목록 모달 *@
@if (_showServicesModal)
{
    <ServiceCatalogModal OnClose="CloseServicesModal" />
}

@* 설정 모달 *@
@if (_showSettingsModal)
{
    <SettingsModal InitialTab="@_settingsModalInitialTab" OnClose="CloseSettingsModal" />
}
